DATABASE_URL="file:./dev.db"

# Required. Left empty on purpose: nothing starts in production with a published value.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# First Telemedi account, created by `npm run db:seed` when none exists.
# Left empty on purpose: the seed skips account creation until you choose a password.
TELEMEDI_NAME="Telemedi Administrator"
TELEMEDI_EMAIL="telemedi@example.com"
TELEMEDI_PASSWORD=""
