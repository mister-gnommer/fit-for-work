generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

enum Role {
  TELEMEDI
  ADMIN
  OPERATOR
}

// The official form's categories I–V.
enum RiskCategory {
  PHYSICAL
  DUSTS
  CHEMICAL
  BIOLOGICAL
  OTHER
}

enum Sex {
  FEMALE
  MALE
}

enum ExamType {
  PRE_EMPLOYMENT
  PERIODIC
  FOLLOW_UP
}

enum ReferralStatus {
  CREATED
  IN_PROGRESS
  CONFIRMED
  DONE
  CANCELLED
}

model Company {
  id             String             @id @default(cuid())
  name           String
  city           String
  street         String?
  buildingNumber String
  flatNumber     String?
  postalCode     String
  nip            String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  users          User[]
  riskFactors    RiskFactor[]
  employees      Employee[]
  referrals      Referral[]
  templates      ReferralTemplate[]

  @@unique([nip], where: raw("deletedAt IS NULL"))
  @@map("company")
}

// companyId is null for the predefined factors (read-only, shared by every company).
model RiskFactor {
  id        String                   @id @default(cuid())
  category  RiskCategory
  name      String
  companyId String?
  // Restrict: a hard-deleted company must not turn its factors into predefined ones.
  company   Company?                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  deletedAt DateTime?
  templates ReferralTemplateFactor[]

  // Predefined rows have a null companyId, and SQLite treats NULLs as distinct, so this only covers company factors.
  @@unique([companyId, category, name], where: raw("deletedAt IS NULL"))
  // Keeps two seed runs at the same time from duplicating the predefined list.
  @@unique([category, name], where: raw("companyId IS NULL"))
  @@map("risk_factor")
}

model Employee {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  firstName        String
  lastName         String
  sex              Sex
  pesel            String?
  idDocumentName   String?
  idDocumentNumber String?
  /// yyyy-MM-dd; only set when there's no PESEL.
  birthDate        String?
  city             String
  street           String?
  buildingNumber   String
  flatNumber       String?
  position         String
  workDescription  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  referrals        Referral[]

  // SQLite treats NULLs as distinct, so employees without a PESEL never collide.
  @@unique([companyId, pesel], where: raw("deletedAt IS NULL"))
  @@index([companyId])
  @@map("employee")
}

model ReferralTemplate {
  id        String                   @id @default(cuid())
  companyId String
  company   Company                  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  deletedAt DateTime?
  factors   ReferralTemplateFactor[]

  @@unique([companyId, name], where: raw("deletedAt IS NULL"))
  @@index([companyId])
  @@map("referral_template")
}

// Hard deleted when a factor is removed from a template. A soft-deleted factor is hidden by every read instead.
model ReferralTemplateFactor {
  id            String           @id @default(cuid())
  templateId    String
  template      ReferralTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  riskFactorId  String
  riskFactor    RiskFactor       @relation(fields: [riskFactorId], references: [id])
  exposureLevel String?

  @@unique([templateId, riskFactorId])
  @@map("referral_template_factor")
}

// Frozen when created: the PDF is rendered from `snapshot`. The columns are the ones we filter on.
// Nothing is hard deleted, so the relations restrict deletes instead of cascading.
model Referral {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  examType    ExamType
  status      ReferralStatus @default(CREATED)
  /// yyyy-MM-dd
  deadline    String
  snapshot    Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([companyId])
  @@map("referral")
}

// Better Auth core models (user, session, account, verification), with its field names.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  deletedAt     DateTime?
  sessions      Session[]
  accounts      Account[]
  referrals     Referral[]

  @@unique([companyId], where: raw("role = 'ADMIN' AND deletedAt IS NULL"))
  @@index([companyId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
